# Select settings with `--settings=...` or an exported OS environment variable.
# python-decouple reads this file only after Django has selected a module, so a
# DJANGO_SETTINGS_MODULE entry here would be misleading.
# Local template only: production requires injected values described in
# docs/configuration.md. Never deploy the placeholders below or commit .env files.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Optional comma-separated previous Django signing secrets during rotation.
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Omit DATABASE_URL to use the development SQLite default, or uncomment:
# DATABASE_URL=postgresql://sanfootball:replace-me@localhost:5432/sanfootball
DATABASE_CONN_MAX_AGE=60

# Production always sets DEBUG=false and secure session/CSRF cookies. Configure
# concrete allowed hosts and exact HTTPS CORS/CSRF origins before deployment.
SECURE_SSL_REDIRECT=true
# Enable only behind a trusted proxy that strips/replaces X-Forwarded-Proto and
# prevents public access to the application port. Otherwise leave false.
TRUST_PROXY_SSL_HEADER=false
# Roll out HSTS after verifying HTTPS; includeSubDomains/preload require separate
# verification of every affected subdomain. These flags affect production only.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Cache and workers
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
# Development uses locmem unless this is explicitly enabled.
USE_REDIS_CACHE=false

# Identity
CLERK_SECRET_KEY=replace-me
CLERK_AUTH_PARTIES=http://localhost:3000

# Giffy callback signing (production requires a random value of 32+ characters)
GIFFY_SHARED_SECRET=replace-with-a-long-random-shared-secret
# Local service addresses; production requires explicit HTTPS origins for both.
MAIN_PUBLIC_BASE_URL=http://127.0.0.1:8000
GIFFY_API_BASE_URL=http://127.0.0.1:8050

# Optional exact callback origins; unset means legacy offline callbacks are denied.
# OFFLINE_WEBHOOK_ALLOWED_ORIGINS=https://hooks.example.com
# The custom offline DRM pipeline is deprecated and disabled by default.
CUSTOM_OFFLINE_DRM_ENABLED=false

# Cloudflare media target. Production requires every value; never commit secrets.
MEDIA_STORAGE_PROVIDER=cloudflare_r2
IMAGE_PLATFORM_PROVIDER=cloudflare_images
VIDEO_PLATFORM_PROVIDER=cloudflare_stream
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_PRIVATE_BUCKET_NAME=replace-with-a-private-bucket
R2_PUBLIC_BUCKET_NAME=replace-with-a-separate-public-bucket
# Set true only after every legacy FileField object has been copied to and
# reconciled against R2_PRIVATE_BUCKET_NAME. Production fails closed otherwise.
MEDIA_FILEFIELD_R2_CUTOVER_CONFIRMED=false
# This domain belongs only to R2_PUBLIC_BUCKET_NAME; never attach it to the
# private bucket. Production rejects an r2.dev hostname.
R2_PUBLIC_BASE_URL=https://media.example.com
CLOUDFLARE_IMAGES_ACCOUNT_HASH=replace-me
CLOUDFLARE_IMAGES_SIGNING_KEY=replace-me
CLOUDFLARE_STREAM_CUSTOMER_CODE=replace-me
CLOUDFLARE_STREAM_SIGNING_KEY_ID=replace-me
# Base64 of the PEM bytes returned by the Stream signing-key setup.
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY_B64=replace-with-base64-pem
CLOUDFLARE_STREAM_WEBHOOK_SECRET=replace-me
MEDIA_UPLOAD_ALLOWED_ORIGINS=https://app.example.com
# Cloudflare Stream expects playback hostnames, not URL origins.
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=app.example.com
MEDIA_UPLOAD_URL_TTL_SECONDS=600
MEDIA_PRIVATE_URL_TTL_SECONDS=600
MEDIA_UPLOAD_MAX_BYTES=5368709120
MEDIA_UPLOAD_MAX_DURATION_SECONDS=36000

# Optional processing providers
OPENAI_API_KEY=replace-me
GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json

# Transitional legacy AWS/CloudFront settings. Remove after verified migration.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=replace-me
AWS_REGION=us-east-1
# Use a custom CDN hostname under the narrowest parent shared with the API host.
# For example: api.example.com + media.example.com -> example.com.
# Keep all four empty when signed CloudFront HLS is unused. If enabled, populate
# them together through secret injection; never paste a private key in this file.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_COOKIE_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_COOKIE_TTL=900
CLOUDFRONT_SIGN_CACHE_TIMEOUT_MARGIN=60
